# ============================================================
# One Rupee — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Cashfree Payment Gateway (required) ---
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox

# --- Server ---
ONE_RUPEE_PORT=8000
ONE_RUPEE_BASE_URL=your_lan_or_public_url_example_http_192_168_1_100_8000
ONE_RUPEE_ENV=development

# --- Supabase (optional, for production database + storage) ---
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=your_postgresql_connection_string

# --- Certificate Storage (optional) ---
CERTIFICATE_STORAGE=local
SUPABASE_CERTIFICATE_PUBLIC=false
